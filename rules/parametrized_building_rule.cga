			s('0.95, '0.5, 0.2)
			i("builtin:cube:notex")
			#WallMaterial("decor_diffuse_2")
			DecorMaterial(rint(rand(0, 2)))
				
	else:
		GroundfloorWall
	
	
Marquize -->
	GroundfloorWall
	
	s('0.95, 0.1, marquize_depth)
	center(x)
	i("builtin:cube:notex")
	r(20, 0, 0)
	MarquizeMaterial

MarquizeMaterial with (
	rand_r := rand(0, 1)
	rand_g := rand(0, 1)
	rang_b := rand(0, 1) ) -->
	setMaterial(readMaterial("/ESRI.lib/assets/Materials/Generic/Terracotta/Terracotta_1x1.cgamat"))
	set(material.color.r, rand_r)
	set(material.color.g, rand_g)
	set(material.color.b, rang_b)
	projectUV(0)
	projectUV(1)
	
	
GroundfloorWall -->
	Wall("groundfloor")


# ===========
# Windows

WindowLOD(facade_ratio) -->
	case LOD == "LOD3":
		t(0, 0, -wall_inset/2)
		Window(facade_ratio)
	else:
		Window(facade_ratio)

Window(window_ratio) -->
	case CONSTRUCTION_DISPLAY:
		# COLOR INDEPENDENT OF FACADE RATIO
	 	case ANNOTATION_METHOD == 2:
	 		#ColorDisplay
	 		ColorDisplay(window_ratio)
	 		X
	 	
	 	case ANNOTATION_METHOD == 3:
	 		#color( get_ratio_color(facade_ratio)) # COLOR DEPENDENT OF FACADE RATIO - abandoned
	 		color(Blue_Color)
	 		X
	 	#case CHOSEN_ELEMENT == "Windows":
		#	#color(RATIO_COLOR)
		#	ColorDisplay
		else:
			color(Blue_Color)
			X
	else:
		setupProjection(0, scope.xy, '1, '1)
		texture(get_window_texture)
		set(material.specular.r,0.5) 
		set(material.specular.g,0.5) 
		set(material.specular.b,0.5)	
		set(material.reflectivity,0.3) 	
		set(material.shininess,20) 
		projectUV(0)
		ColorWindow

# ADDITIONAL COLOR, not a TEXTURE
ColorWindow --> 
	color(window_color) 
	


getWindowColorBlue =
	5%:  "#D0E0F0"   // 5%
	5%:  "#B8D4EA"   // 5%
