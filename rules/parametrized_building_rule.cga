get_all_groundfloor_tile_texture(type) =
	fileSearch(EsriLibraryLocation + EsriTextureLocation + "/Groundfloors/g_f001_t00" + str(type) + "_Mercantile*")


get_all_window_textures =
	fileSearch(WindowTextureLibraryLocation + "/*")

get_all_door_textures = 
	fileSearch(DoorTextureLibraryLocation + "/doors.*")	

	
#attr material_groundfloor_theme_lib_path =
# 	50%: EsriLibraryLocation + ""
#	else: ""		


get_all_grass_colormap = 
	fileSearch("/ESRI.lib/assets/Materials/Vegetation/Grass/Textures/*Color.jpg")


get_upperfloors_material_theme = 
	60%: "Brick"
	20%: "Concrete"
	else: "Plaster"


get_all_materials(path) =
	fileSearch(path + "/*.cgamat")

get_all_objects(path) =
	fileSearch(path + "/*.glb")


get_some_object = 
	40%: listRandom(get_all_objects(StreetSceneLibrary))
	40%: listRandom(get_all_objects(VegetationLibrary))
	else: listRandom(get_all_objects(RecreationLibrary))

get_some_object(type) = 
	case type == 0:
		listRandom(get_all_objects(StreetSceneLibrary))
	else: #type == 1:
		listRandom(get_all_objects(VegetationLibrary))
	#else: 
	#	listRandom(get_all_objects(Library))


getHexValue(value) = 
	case value < 16:
		[0, value]
	else:
		getHex(value, [-1])
	
getHex(value, hexs) with (
	total_part := rint(floor(value / 16))) =
	case value == 0: 
		hexs[1:2]
	else:
		case total_part == 0:
			getHex(0, [hexs, value])
		else:
			getHex(value-total_part*16, [hexs, rint(total_part)])

# substring is necessary, because of a floating bite
getHexStr(hexs) = 
	substring(getHexLetter(hexs[0]) + getHexLetter(hexs[1]), 0, 2)
	#getHexHelper(hexs, "#")
	
	
	
#getHexHelper(hexs, acc) with ( n:= size(hexs)) =
#	case n == 1:
#		acc + getHexLetter(hexs[0])
#	else:
#		getHexHelper(hexs[1:n], acc + getHexLetter(hexs[0]))


getHexLetter(value) = 
	case value < 10:
		str(value)
	case value == 10:
		"A"
	case value == 11:
		"B"
	case value == 12:
		"C"
	case value == 13:
		"D"
	case value == 14:
		"E"
	else:
		"F"



# FUNCS
# -------------------------------------------------------
 


# -------------------------------------------------------
# RULES

# Starting rule for corner lot in a network block
LotCorner  -->
	case CONSTRUCTION_DISPLAY == true:
		NIL
	else:
		Scatter		
		setupProjection(0, scope.xz, 10, 10)
		texture(get_grass_texture)
		projectUV(0)
		X
		#projectUV(5)
		

Grass2 -->
	setupProjection(0, scope.xz, 10, 10)
	texture(get_grass_texture)
	projectUV(0)


		
Scatter with (n_of_elements := rint(rand(2, 5))) -->
   	offset(-1)
   	comp(f){
   	inside: scatter(surface, n_of_elements, gaussian) { UrbanFurniture }
   	|border: NIL }
   

UrbanFurniture with (object_type := rint(rand(0,2)))-->
 	#s(rand(1, 3),rand(5, 10),rand(1, 3))
 	case object_type == 1:
 		s(rand(1, 4), rand(6, 10), rand(1, 4))
 		i(get_some_object(object_type))
 	else:
 		i(get_some_object(object_type))
	#i("/ESRI.lib/assets/Webstyles/Vegetation/Realistic/AcerPlatanoides.glb")
   #primitiveCube()

   #color("#ff0000")
	
ScaleDown -->
	case scope.sx > 5 || scope.sy > 10 || scope.sz > 5:
		s('0.9, '0.9, '0.9)
	else:
		X

# Starting rule for inner lot in a network block
LotInner -->
	Grass
	#Lot


# law of cosinus
get_edge_length(n_of_sides_x, radius_x) =
	sqrt(2*radius_x*radius_x - 2*radius_x*radius_x*cos(360/n_of_sides_x))

get_radius(sx, sy) =
	rand(15, 0.5*min(sx, sy))


attr n_of_edges = rint(rand(3, 5.5))

InsertCylinder with (
	radius_b := get_radius(scope.sx, scope.sz)
	edge_length := get_edge_length(n_of_edges, radius_b)
	# ACTUAL BUILDING HEIGHT
	building_height := edge_length / RATIO_PARAMETER3
	)-->
	primitiveCylinder(n_of_edges, radius_b, building_height)
	comp(f){
		side: Front_X 
		| top: Roof_X
	}

@StartRule
Lot -->			
	#Mass
	case DATASET_METHOD == "1":
		InsertCylinder
		Grass
	else:
		print("RATIO PARAMETER 3")
		print(RATIO_PARAMETER3)
		print("RATIO PARAMETER 4")
		print(RATIO_PARAMETER4)
		extrude(building_height)
		print("PARAMETER LIST 1")
		print(PARAMETERS_LIST)
		print("PARAMETER LIST 2")
		print(PARAMETERS_LIST_AUX)
		print(floor(0.3))
		print(floor(0.9))
		print(floor(1.2))
		print(floor(2.))
		print(floor(9.5))
		
		Mass
		#offset(-0.5)
		#comp(f){inside: Mass | border: X}
		
		
	
Grass -->
	case CONSTRUCTION_DISPLAY:
		NIL
	else:
		setupProjection(0, scope.xz, 10, 10)
		texture(get_grass_texture)
		projectUV(0)
		X
	
Mass -->
	
	comp(f){front: Front_X | side: Front_X | top: Roof_X}
	

# ==============================
# FRONT

Front_X -->
	case CONSTRUCTION_DISPLAY == true:
		#case CHOSEN_ELEMENT == "Building":
		case ANNOTATION_METHOD == 1:
			WhiteFrame #color(Red_Color)
		else:
			Front 
			WhiteFrame_M2 
	else:
		Front	

WhiteFrame -->
	offset(-0.4)
	comp(f){
		inside: ColorDisplayFacade
		|border: X
	}
	
	
WhiteFrame_M2 -->
	offset(-0.25)
	comp(f){
		inside: NIL
		|border: extrude(0.025) color(1, 1, 1) X
	}#
	
	
ColorDisplayFacade with (
	facade_ratio := roundTo2(scope.sx / scope.sy)
	#facade_ratio_color := get_ratio_color(facade_ratio) 
	facade_ratio_color := get_ratio_color					# color independent of current facade ratio, facade ratio bounded with fixed RATIO_PARAMETER3 parameter (too many ratios and ratio_lists...)
	) -->
	
	case ANNOTATION_METHOD == 1:		
		set(material.opacity, 1)
		color(facade_ratio_color)
	else:
		X
	
ColorDisplay -->
	set(material.opacity, 1)
	color(get_ratio_color)

ColorDisplay(ratio_type) -->
	case ratio_type == 0:
		set(material.opacity, 1)
		color(get_ratio_color)
	else:
		set(material.opacity, 1)
		color(get_ratio_color(RATIO_PARAMETER4))
	
	
Front with ( 
	facade_width := scope.sx
	facade_height := scope.sy
	facade_ratio := roundTo2(facade_width / facade_height)
	facade_ratio_color := get_ratio_color(facade_ratio)   ) -->
	setupProjection(0, scope.xy, 10, 10)
	split(x){edge_decors_width: EdgeDecorSides("left") | ~1: split(y){~1: MainFacade(facade_ratio) | edge_decors_vertical : EdgeDecorTop} | edge_decors_width: EdgeDecorSides("right")}


MainFacade(facade_ratio) -->
	split(y){groundfloor_facade_height: Groundfloor | ~1: Upperfloors(facade_ratio)}


# ===========
# GROUNDFLOOR

Groundfloor -->
	split(y){~1: GroundfloorSplitY | 0.5: GroundfloorDecor}
	
# PARAMETRIZED DOOR
GroundfloorSplitY with (
	sy := scope.sy
	door_height := min(max_door_height, 0.7*sy)
	#door_width := case DATASET_METHOD == "1": door_height*RATIO_PARAMETER3 else: door_height*RATIO_PARAMETER3*rand(0.5, 1)
	door_width := door_height*RATIO_PARAMETER3*rand(0.5, 1)
	door_placement_x := listRandom(listFromArray(Door_Placement)) )-->
	case door_placement_x == "center":
		split(x){~1: GroundfloorSidePart | door_width + 1: DoorsTile(door_height, door_width) | ~1: GroundfloorSidePart}
	case door_placement_x == "left":
		split(x){~1: GroundfloorSidePart | door_width + 1: DoorsTile(door_height, door_width) | ~3: GroundfloorSidePart}
	else:
		split(x){~3: GroundfloorSidePart | door_width + 1: DoorsTile(door_height, door_width) | ~1: GroundfloorSidePart}


# =============
# DOORS

DoorsTile(door_height, door_width) -->
	split(x){~1: DoorTileSides("left", door_height) 
	| door_width: 
		split(y){rand(0.1, 0.3): DoorTileBottom | door_height: DoorsLOD | ~1: DoorTileTop(door_height)} 
	| ~1: DoorTileSides("right", door_height)
	}

DoorsLOD -->
	case LOD == "LOD3":
		DoorBackground
		Doors
	else:
		ProjectTextureDoors
	
DoorBackground -->
	s('1, '1, wall_inset)
	i("builtin:cube:notex")
	t(0, 0, -wall_inset)
	comp(f){top: WallDecor(2) | back: WallDecor(2)}
	
	
	
Doors -->
	50%: 
		s('1, '1, wall_inset)
		i("builtin:cube:notex")
		t(0, 0, -rand(0.9,1) * wall_inset)
		inline  ProjectTextureDoors #DoorsColor
	else:
		s('1, '1, wall_inset)
		i("builtin:cube:notex")
		t(0, 0, -rand(1,2) * wall_inset)
		inline  ProjectTextureDoors #DoorsColor
		
@Hidden
attr door_colors = [rand(0.5, 1), rand(0.5, 1), rand(0.5, 1)]

DoorsColor -->
	case CONSTRUCTION_DISPLAY:
		#case METHOD == 3:
		#	ColorDisplay
		#else:
			X
	else:
		color(door_colors[0], door_colors[1], door_colors[2])
	

#DiffuseMaterialRoof(type) -->
#	case type == 0:
#		DiffuseMaterial(type)
#	else:
#		inline DiffuseMaterial(type) color(rooftype_colors[0], rooftype_colors[1], rooftype_colors[2])


attr doortile_side_h_factor = rand(1.25, 1.5)

DoorTileSides(side, door_height) -->
	case doortile_type == 0:
		split(y){doortile_side_h_factor*door_height: DoorTileSideFrame(side) | ~1: GroundfloorWall}
	case doortile_type == 1:
		GroundfloorWall
	else:
		Wall("decor")
	
DoorTileSideFrame(side) -->
	case side == "left":
		case doortile_type == 0:	
			split(x){~1: GroundfloorWall | ~1: UpperfloorsWall}
		case doortile_type == 1:
			GroundfloorWall
		else:
			Wall("decor")
			#DecorMaterial(1)
	else:
		case doortile_type == 0:
			split(x){~1: UpperfloorsWall | ~1: GroundfloorWall}
		case doortile_type == 1:
			GroundfloorWall
		else:
			Wall("decorative 1")
			#DecorMaterial(1)
			
	
DoorTileBottom -->
	#Wall("decorative 2")
	#DecorMaterial(2)
	GroundfloorWall
	
DoorTileTop(door_height) -->
	case doortile_type == 0:
		split(y){(doortile_side_h_factor-1)*door_height: UpperfloorsWall | ~1: GroundfloorWall}
	case doortile_type == 1:
		GroundfloorWall
	else:
		case LOD == "LOD3":
			split(y){'rand(0, 0.5): Doortop | ~1: Wall("decor")}
		else:
			split(y){'rand(0, 0.5): Wall("decorative") | ~1: Wall("decor")}

Doortop -->
