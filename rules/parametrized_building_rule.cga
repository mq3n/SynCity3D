			projectUV(0)


# ====================

GroundfloorSidePart with (
	sx := scope.sx
	sy := scope.sy
	initial_groundfloor_tile_width := min(sx, rand(3, 5))
	correction := get_n_and_length_of_tile(sx, initial_groundfloor_tile_width)
	n := correction[0]
	width := correction[1]
	area_splits := get_n_splits_of_1(min(n, 4)) 
	n_splits := size(area_splits) )-->
	case n_splits == 1:
		splitArea(x){'area_splits[0]: GroundfloorSidePartTile}
	case n_splits == 2:
		splitArea(x){'area_splits[0]: GroundfloorSidePartTile | 'area_splits[1]: GroundfloorSidePartTile}
	case n_splits == 3:
		splitArea(x){'area_splits[0]: GroundfloorSidePartTile | 'area_splits[1]: GroundfloorSidePartTile | 'area_splits[2]: GroundfloorSidePartTile}
	else:
		splitArea(x){'area_splits[0]: GroundfloorSidePartTile | 'area_splits[1]: GroundfloorSidePartTile | 'area_splits[2]: GroundfloorSidePartTile | 'area_splits[3]: GroundfloorSidePartTile}
	

GroundfloorSidePartTile with (
	sx := scope.sx
	sy := scope.sy )-->
	case sx < 1.25:
		split(y){bottom_ledge_height: GroundfloorSidePartTileBottom | ~1: GroundfloorWall}
	case sx > 6:
		split(y){bottom_ledge_height: GroundfloorSidePartTileBottom | ~1: GroundfloorSidePartTileDisplay(2)}
	case sx > 3:
		split(y){bottom_ledge_height: GroundfloorSidePartTileBottom | ~1: GroundfloorSidePartTileDisplay(1)}
	else:
		split(y){bottom_ledge_height: GroundfloorSidePartTileBottom | ~1: GroundfloorSidePartTileDisplay(0)}


GroundfloorSidePartTileDisplay(type) -->
	40%:
		case type != 0:
			split(y){~1: split(x){rand(0.2, 0.5): GroundfloorWall | ~1: GroundfloorTextureDisplay(type)} | rand(0.2, 0.5): GroundfloorTileDecorTextures }
			
		else:
			GroundfloorWall
	40%:
		split(y){~1: split(x){rand(0.2, 0.5): GroundfloorWall | ~1: GroundfloorTileDisplay(type)} | rand(0.2, 0.5): GroundfloorWall }
	else:
		GroundfloorWall
		
GroundfloorTextureDisplay(type) -->
	case LOD == "LOD3":
		66%:
			t(0, 0, -wall_inset)
			ProjectTexture( get_mercantile_texture(type) )
		else:		
			GroundfloorWall
	else:
		66%:
			ProjectTexture( get_mercantile_texture(type) )
		else:
			GroundfloorWall
		
GroundfloorTileDecorTile -->
	case LOD == "LOD3":
		t(0, 0, -wall_inset)
		DecorMaterial(rint(rand(0, 1)))
	else:
		DecorMaterial(rint(rand(0, 1)))
		
		
# no cases for now
GroundfloorTileDisplay(type) with (
	rand_split_h := rand(0.5, 1)
	rand_rhytm := rand(0.5, 1.5)
	rhytm_split := rand_rhytm*rand_split_h ) -->
	case type ==  1:
		split(x){rand_split_h: GroundfloorWall | rhytm_split: GroundfloorTileDecorTile}*
	else:
		split(y){rand_split_h: GroundfloorWall | rhytm_split: GroundfloorTileDecorTile}*


ProjectTexture(texture_) -->
		case CONSTRUCTION_DISPLAY:
			#METHOD
			#color(Green_Color)
			color(Blue_Color)
		else:
			setupProjection(0, scope.xy, '1, '1)
			texture(texture_)
			projectUV(0)
			
				
GroundfloorTileDecorTextures -->
	case LOD == "LOD3":
		case CONSTRUCTION_DISPLAY == false:
			50%: Marquize
			else: GroundfloorWall
		else:
			#METHOD
			s('1, '1, wall_inset)
			t(0, 0, -wall_inset)
			i("builtin:cube:notex")
			#color(Green_Color)
			color(Blue_Color)
	else:
		Wall("decorative 1")
	

GroundfloorSidePartTileBottom -->
	case CONSTRUCTION_DISPLAY:
		#METHOD
		s('1, '1, wall_inset)
		i("builtin:cube:notex")
		t(0, 0, -wall_inset)
		#color(Green_Color)
		color(Blue_Color)
	else:
		case LOD == "LOD3":
			s('1, '1, 0.1)
			i("builtin:cube:notex")
			GroundfloorWall
		else:
			s('1, '1, 0.1)
			i("builtin:cube:notex")
			GroundfloorWall

# ledge in the top part of groundfloor
GroundfloorDecor with (
	decor_percentage := roundTo2(rand(0.3, 0.9)) ) -->
	case LOD == "LOD3":
		30%:
			GroundfloorWall	#nothing
		#50%:
			#	split(x){'decor_percentage: Marquize | ~1: GroundfloorWall}
		else:
