# UPPERFLOORS
	
	
Upperfloors(facade_ratio) with (
	tile_column_info := get_n_and_length_of_tile(scope.sx, initial_tile_width)
	n_of_cols := tile_column_info[0]
	tile_width := tile_column_info[1] )-->

	split(x){
		~tile_width: SplitY(split.index, facade_ratio)
	}*


SplitY(x_index, facade_ratio) -->
	split(y){
		~tile_height: UpperfloorsTile(x_index, split.index, facade_ratio)
	}*

	
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
# DOMINANT RATIO
# !!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!!
UpperfloorsTile(x_index, y_index, facade_ratio) with (
	#window_ratio_type:=
	#	80%: 0 # RATIO_PARAMETER3
	#	else: 1 # RATIO_PARAMETER4
	window_ratio_type := 
		case DOMINANT_PROPORTION == false: 	#!! == true ...
			0 # RATIO_PARAMETER3
		else: 
			80%: 0 # RATIO_PARAMETER3
			else: 1 # RATIO_PARAMETER4
				
	windowtile_x := scale_windowtile_for_tile(scope.sx, scope.sy, window_ratio_type)
	#windowtile_x := scale_windowtile_for_tile(scope.sx, scope.sy)
	windowtile_width := windowtile_x[0]
	windowtile_height := windowtile_x[1]) -->	 
	split(y){
		~(1+regularity_factor*rand(0, 2)): UpperfloorsTileWall("bottom", x_index, y_index)
		|windowtile_height: split(x) {
			 ~(1+regularity_factor*rand(0,2)): UpperfloorsTileWall("left", x_index, y_index)
			 | windowtile_width: WindowTile(window_ratio_type)
			 |~1: UpperfloorsTileWall("right", x_index, y_index)
			}
		|~1: UpperfloorsTileWall("top", x_index, y_index)
	}


# 0 - in rows, 1 - in cols
#@Enum(valuesAttr=[0,1])
attr upperfloors_decor_type = rint(rand(0,1))

@Enum(valuesAttr=[true, false])
attr upperfloors_decor_on = 
	50%: true
	else: false
	
UpperfloorsTileWall(side, i, j) -->
	case upperfloors_decor_on:
		case upperfloors_decor_type == 0:
			case side == "top":
				UpperfloorsWall
				split(y){~1: UpperfloorsWall | '0.2: DecorMaterial(1) }
			case side == "bottom":
				split(y){'0.2: DecorMaterial(1) | ~1: UpperfloorsWall }
			else:
				UpperfloorsWall
		else:
			case side == "left":
				split(x) {'0.2: DecorMaterial(1) | ~1: UpperfloorsWall}
			case side == "right":
				split(x) {~1: UpperfloorsWall | ~0.2: DecorMaterial(1)}
			else:
				split(x){'0.1: DecorMaterial(1) | ~1: UpperfloorsWall | '0.1: DecorMaterial(1)}
			#else:
			#	UpperfloorsWall
				
	else:
		UpperfloorsWall



WindowTile(window_ratio) with (
	window_w := scope.sx / windowtile_to_window_ratio
	window_h := scope.sy / windowtile_to_window_ratio) -->
	split(x){
		~1: WindowTileWall
		| window_w: split(y) {
			~1: WindowTileWall
			|window_h: WindowLOD(window_ratio)
			|~1: WindowTileWall
			}
		| ~1: WindowTileWall
	}
	
WindowTileWall -->
	Wall("decorative")
	

UpperfloorsWall -->
	Wall("upperfloors")


# ===========
# SIDE - abandoned for now

Side_X -->
	case CONSTRUCTION_DISPLAY == true:
		#color(Green_Color)
		color(Blue_Color)
	else:
