	color(Blue_Color)
	#color(Green_Color)


# ===================
# DECORS

EdgeDecorSides(side) -->
	case CONSTRUCTION_DISPLAY:
		#METHOD
		s('1, '1, wall_inset)
		t(0, 0, -wall_inset)
		i("builtin:cube:notex")
		#color(Green_Color)
		color(Blue_Color)
	else:
		case LOD == "LOD3":
			case side == "left":
				split(y){ 0.3: EdgeDecorSplitY(side, "full", split.index) | ~0.3: EdgeDecorSplitY(side, "short", split.index)}*
			else:
				split(y){ 0.3: EdgeDecorSplitY(side, "full", split.index) | ~0.3: EdgeDecorSplitY(side, "short", split.index)}*
		else:
			split(y){groundfloor_facade_height: GroundfloorWall | ~1: UpperfloorsWall | edge_decors_vertical : Wall("decor")}
		
	
EdgeDecorsSidesSplit(side) -->
	split(y){groundfloor_facade_height: X | ~1: X}
	
		
EdgeDecorSplitY(side, length, split_index) -->
	case side == "left":
		case scope.sy*split_index <= groundfloor_facade_height:
			GroundfloorWall
			EdgeDecorSidesBricks(length)
		case scope.sy*split_index >= building_height - edge_decors_vertical :
			case roof_type != "flat":
				DecorMaterial(1)
			else:
				EdgeDecorSidesBricks(length)
		else:
			WallMaterial("upperfloors")
			EdgeDecorSidesBricks(length)
			
	else:
		case scope.sy*split_index <= groundfloor_facade_height:
			GroundfloorWall
			mirrorScope(true, false, false)
			EdgeDecorSidesBricks(length)
		case scope.sy*split_index >= building_height - edge_decors_vertical :
			case roof_type != "flat":
				#WallMaterial("decor")
				DecorMaterial(1)
			else:
				mirrorScope(true, false, false)
				EdgeDecorSidesBricks(length)
		else:
			WallMaterial("upperfloors")
			mirrorScope(true, false, false)
			EdgeDecorSidesBricks(length)
		

EdgeDecorSidesBricks(length) -->
	case length == "full":
		split(x){0.8 * edge_decors_width: EdgeDecorBrick | ~1: NIL }
	else:
		split(x){roundTo2(edge_decors_width / 2): EdgeDecorBrick | ~1: NIL}

EdgeDecorBrick -->
	s('1, '1, 0.2)
	i("builtin:cube")
	DecorMaterial(1)


EdgeDecorTop -->
	case CONSTRUCTION_DISPLAY:
		# METHOD
		#color(Green_Color)
		color(Blue_Color)
	else:
		case LOD == "LOD3":
			setupProjection(0, scope.xy, 10, 10)
			split(y){ 0.1: WallDecor(0) | ~1: EdgeDecorTopAsset}
		else:
			WallDecor(0)

EdgeDecorTopSplitX -->
	split(x){'0.2: EdgeDecorTopAsset}*
	
	
EdgeDecorTopAsset with (decor_material_type := rint(rand(0, 1))) -->
	case CONSTRUCTION_DISPLAY:
		#X
		DecorMaterial(decor_material_type)
	else:
		case roof_type == "Hip":
			s('1, '1, rand(0, 0.1)*rooftop_overhang_size)
			#i(Ledge_Asset)
			DecorMaterial(decor_material_type)
		else:
			s('1, '1, rooftop_overhang_size)
			i(Ledge_Asset)
			DecorMaterial(decor_material_type)



# ===========
# WALL


# WHEN WE WANT SOLID WALL + MATERIAL	
Wall(type) -->
	s('1, '1, wall_inset)
	t(0, 0, -wall_inset)
	i("builtin:cube:notex")
	WallMaterial(type)


DiffuseMaterial(type) -->
	case type == 1:
		set(material.color.r, diffuse_color_1)
		set(material.color.g, diffuse_color_1)
		set(material.color.b, diffuse_color_1)
	else:
		set(material.color.r, diffuse_color_2)
		set(material.color.g, diffuse_color_2)
		set(material.color.b, diffuse_color_2)


# SETTING UP A MATERIAL AND PROJECTING IT
WallMaterial(type) -->
	case CONSTRUCTION_DISPLAY == false:
		case type == "groundfloor":
			setMaterial(readMaterial(groundfloor_material))
			inline DiffuseMaterial(1) projectUV(0)
		case type == "upperfloors":
			setMaterial(readMaterial(upperfloors_material))
			projectUV(0)
		case type == "decorative":
			setMaterial(readMaterial(decor_material))
			projectUV(0)
		case type == "decorative 1":
			setMaterial(readMaterial(decor_material))
			inline DiffuseMaterial(1) projectUV(0)
		else:
			setMaterial(readMaterial(decor_material))
			inline DiffuseMaterial(2) projectUV(0)
				
	else:
		case ANNOTATION_METHOD != 0:
			#s('1, '1, wall_inset)
			#i("builtin:cube:notex")
			#t(0, 0, -wall_inset)
			#color(Green_Color)
			color(Blue_Color)
			X
		else:
			X
			
DecorMaterial(type) -->
	case type == 1:
		WallMaterial("decorative 1")
	else:
		WallMaterial("decorative 2")


# WHEN WE WANT TO ACCESS ONLY THE MATERIAL, WITHOUT SOLID WALL, f.e. assets
WallDecor(type) -->	
	case type == 1:
			WallMaterial("decorative 1")
	else:
			WallMaterial("decorative 2")
		

# ==============================
# ROOF

attr CHOSEN_ELEMENT = "a"

Roof_X -->
	case LOD != "LOD1":
		#case CONSTRUCTION_DISPLAY == true:
		# 	case CHOSEN_ELEMENT == "Roof":
		#		inline Roof ColorDisplay #color(RATIO_COLOR)
		#	else:
		#		Roof
		#	
		#else:
			Roof
	else:
		FlatRoof	


get_even_hip_value = 
	70%: true
	else: false

attr even_hip = get_even_hip_value
attr angle = floor(rand(20, 100))

	
Roof with (
	angle := floor(rand(40, 60))
	even_hip := get_even_hip_value
	n_of_edges := geometry.nEdges()
	roof_type_x := case n_of_edges >= 4: "Flat" else: 70%: "Hip" else: "Flat"
	) -->
	
	case roof_type_x == "Hip": 
		roofHip(angle, rooftop_overhang_size, even_hip)
		#set(trim.horizontal, true)
		split(y){'rand(0.2, 0.5): comp(f){ side: RoofLOD} | ~1: comp(f){bottom: Top}}
		
		#comp(f){side: RoofLOD}
	   	#RoofLOD
	else:
		offset(rooftop_overhang_size)
		comp(f){border: Offset | inside: Top}
	
	
Offset -->
	reverseNormals()
	extrude(1)
	RoofTexture
	modify(f){bottom: color(Red_Color)}
	
Top -->
	#FlatRoof
	RoofLOD
	
	
FlatRoof -->
	RoofTexture
	

RoofLOD -->
	case LOD == "LOD3":
		setupProjection(0, scope.xy, '1, '1)
		RoofTexture
		#split(y){1: RoofTexture | 1: split(x){~1: RoofTexture | 1: Chimney | ~1: RoofTexture} | ~1: RoofTexture}
	else:
		setupProjection(0, scope.xy, '1, '1)
		RoofTexture

attr roof_texture_type = rint(rand(0,2))
RoofTexture -->
	case CONSTRUCTION_DISPLAY == false:
		setMaterial(readMaterial(roof_material))
		inline DiffuseMaterialRoof(roof_texture_type)  projectUV(0)
	else:
		X
		# NIL	# roof stays

@Hidden
attr rooftype_colors = [rand(0.2,1), rand(0.2,1), rand(0.2,1)] 

DiffuseMaterialRoof(type) -->
	case type == 0:
		DiffuseMaterial(type)
	else:
		inline DiffuseMaterial(type) color(rooftype_colors[0], rooftype_colors[1], rooftype_colors[2])


