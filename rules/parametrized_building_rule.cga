# replaced on creation (not really, but shortly after)
const PARAMETERS_LIST_AUX = [0.5,0.8, 1.0, 1.5, 2., 2.5] #[0.5, 0.8, 1.0, 1.5, 2., 2.5]

# CRUCIAL 
attr PARAMETERS_LIST = PARAMETERS_LIST_AUX

# ACTUAL RATIO USED IN PROCEDURES
attr RATIO_PARAMETER3 = get_element_list(PARAMETERS_LIST)


@Hidden @Description("whether building should have equal facade figures")
attr dataset_methods = ["1", "2"]	#to do: unify strings/int
@Hidden @Enum(valuesAttr=dataset_methods)
attr DATASET_METHOD = "2"


attr RATIO_PARAMETER4 = get_other_element_from_list(PARAMETERS_LIST, RATIO_PARAMETER3, RATIO_PARAMETER3, 0)


get_other_element_from_list(my_list, value, current_value) = 
	case current_value == value: get_other_element_from_list(my_list, value, get_element_list(my_list))
	else:
		current_value

@Hidden
attr increase_random = floor(rand(0, 5))
# tried to increase randomness... because the (ratio3, ratio4) wasnt very diverse
get_other_element_from_list(my_list, value, current_value, i) = 
	case current_value == value: get_other_element_from_list(my_list, value, get_element_list(my_list), i+1)
	else:
		case i >= increase_random:
			current_value
		else:
			get_other_element_from_list(my_list, value, get_element_list(my_list), i+1)


get_element_list(my_list) = 
	case size(my_list) == 1:
		my_list[0]
	else:
		my_list[floor(rand(0, size(my_list)))]
		#my_list[rint(rand(0, size(my_list)-0.5))]

attr CONSTRUCTION_DISPLAY = false


#@Hidden
#attr Compositional_Elements = ["Building", "Windows", "Door", "Roof"]
#@Enum(valuesAttr=Compositional_Elements) @Hidden
#attr CHOSEN_ELEMENT = "Building"

# integer, nr 3 is abandoned

@Range(min=1, max=2, stepsize=1)
#@Enum(valuesAttr=[1, 2, 3])
attr ANNOTATION_METHOD = 1


# !!!!
attr DOMINANT_PROPORTION = true

@Color
attr RATIO_COLOR = get_ratio_color

# we look only at RED channel

get_ratio_color = 
	"#" + getHexStr(getHexValue(RATIO_PARAMETER3*100)) + "0000"	
	#"#ff0000"

	
# we assume ratio wont be higher than 2.55*2 = 5.10
get_ratio_color(ratio) =
	case ratio < 2.56: 
		#get_ratio_color
		"#" + getHexStr(getHexValue(ratio*100)) + "0000"
	else:
		"#ff" + getHexStr(getHexValue(roundTo2(ratio - 2.55)*100)) + "00"	


#get_hex = colorRGBToHex(RATIO_PARAMETER*100, 0, 0)
	

@Hidden @Description("Level of Detail")
attr Level_of_Detail = ["LOD1", "LOD2", "LOD3"]
