# 
@Hidden @Description("regularity of spatial arrangement")
attr Facade_Layouts = ["regular net", "irregular net"]

@Enum(valuesAttr=Facade_Layouts)
attr Facade_Layout = "regular net"
	#95%: "regular net"
	#else: "irregular net"


@Hidden
attr regularity =
	case Facade_Layout == "regular net": 
		true
	else: false 

@Hidden
attr regularity_factor =
	case regularity:
		0
	else:
		1


@Enum(valuesAttr=Roof_Types)
attr roof_type = 
	30%: "Flat"
	else: "Hip"

	
# currently only 2 types
