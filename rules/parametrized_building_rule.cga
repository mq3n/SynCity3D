# -------------------------------------------------------
# FUNCS

# 'correct' initial value, so the n e Z
get_n_and_length_of_tile(total, initial) with (n := ceil(total/initial)) = [n, total/n]
	
get_n_splits_of_1(n) = 
	get_n_splits(n, [-1], 0)
		
get_n_splits(n, splits, acc) with (rand_split := rand(0.1, min(0.4, 1-acc))) =
	case size(splits) == n+1: splits[1:n]
	case size(splits) == n: get_n_splits(n, [splits, 1-acc], 1)
	else:
		get_n_splits(n, [splits, rand_split], acc+rand_split)

#to leave some wall space, max_window_tile_ration is like 0.7, so it covers 0.7x0.7 of tile space
# PRESERVE RATIO AND ADJUST TO TILE, current initial_window size is too big for given layout		
scale_windowtile_for_tile(tile_width_x, tile_height_x, ratio_type) with (
		windowtile_width_x := windowtile_to_window_ratio * initial_window_width
		#windowtile_height_x := windowtile_to_window_ratio * initial_window_height
		windowtile_height_x :=
			case ratio_type == 0: windowtile_to_window_ratio * initial_window_height
			else: windowtile_to_window_ratio * initial_window_height_minor
		) =
	scale_X_to_Y(tile_width_x, tile_height_x, windowtile_width_x, windowtile_height_x)
	
 scale_X_to_Y(tile_width_x, tile_height_x, current_windowtile_w, current_windowtile_h) =
 	case current_windowtile_w <= max_windowtile_tile_ratio*tile_width_x && current_windowtile_h <= max_windowtile_tile_ratio*tile_height_x:
 		[current_windowtile_w, current_windowtile_h]
 	else:
 		scale_X_to_Y(tile_width_x, tile_height_x, scaling_factor_1*current_windowtile_w, scaling_factor_1*current_windowtile_h)

get_sign = 
	50%: 1
	else: -1


#"/ESRI.lib/assets/Facades/International/Groundfloors/g_f001_t001_Mercantile_006.jpg"
get_mercantile_texture(type) = listRandom(get_all_groundfloor_tile_texture(type))
get_window_texture = listRandom(get_all_window_textures)
get_material(path) = listRandom(get_all_materials(path))
get_material_groundfloor = listRandom(  get_all_materials(gf_material_library_path) + get_all_materials(cladding_wood_material_library_path) + get_all_materials(cladding_terracotta_material_library_path)  ) 
get_door_texture = listRandom(get_all_door_textures)
get_grass_material = listRandom(get_all_materials(vegetation_grass_library_path))
get_grass_texture = listRandom(get_all_grass_colormap)

